---
import '@fontsource/titillium-web';
import Header from "@components/Header.astro";
import Footer from '@components/Footer.astro';
import { Analytics } from '@vercel/analytics/react'

interface Props {
	title: string;
	description: string;
};

const { title, description } = Astro.props;
const lang = Astro.currentLocale || "es";
---

<!doctype html>
<html lang={lang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Desarrollador Web Full Stack, Programador Web, Full Stack JavaScript, Desarrollo de aplicaciones web, Desarrollo de aplicaciones móviles, Contratar desarrollador web, Fernando Muñoz desarrollador, Tecnologías JavaScript, Desarrollo web profesional, Servicios de programación web, Node.js, React, Next.js, Tailwind CSS, Desarrollo front-end, Desarrollo back-end, Programador freelance, Creación de aplicaciones personalizadas, Diseño web responsivo, Programación de APIs, Optimización de aplicaciones web, Desarrollo ágil de software, Consultor de desarrollo web, Desarrollador web en Chile, Programador web chileno, Servicios de desarrollo web en Santiago">
		<meta name="author" content="Fernando Muñoz">
		<link rel="canonical" href="https://fernandomunoz.vercel.app/">
		<meta name="robots" content="index, follow">
		<meta name="publisher" content="Fernando Muñoz - Desarrollador Web">
		<meta name="google-site-verification" content="Ff_zypdntAA7-SeYJWWFER4tUTswZ_awj0sft8S5zCA" />
		<!-- Anti-FOUC: Apply theme before paint -->
		<script is:inline>
			(function() {
				const theme = localStorage.getItem('theme') || 'dark';
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body class="dark:text-white text-gray-900">
		<div class="fixed top-0 left-0 z-[-2] min-h-screen min-w-full
			dark:bg-[#000000] dark:bg-[radial-gradient(#ffffff33_1px,#000400_1px)]
			bg-[#f0f0f0] bg-[radial-gradient(#00000015_1px,#f0f0f0_1px)]
			bg-[size:20px_20px]"></div>
		<Header />
		<slot />
		<Footer />
		<Analytics client:only="react" />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--color-mainBg: #b38600;
		--color-tertiary: #3a7d1c;
	}

	.dark {
		--color-mainBg: #ffcf52;
		--color-tertiary: #d5ed9f;
	}
	
	html {
		font-family: 'Titillium Web', sans-serif;
		box-sizing: border-box;
		scroll-behavior: smooth;
		scroll-padding-top: 5rem;
	}
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background-repeat: repeat;
	}

	*, *::before, *::after {
		box-sizing: inherit;
	}

	@media (prefers-reduce-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>