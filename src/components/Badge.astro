---
import { useTranslations } from "src/i18n/utils";

interface Props {
    status?: "available" | "working";
}

const { status = "available" } = Astro.props;

const lang = (Astro.currentLocale as "es" | "en") || "es";
const t = useTranslations(lang);

const isAvailable = status === "available";

const classes = isAvailable
    ? "bg-blue-100 text-blue-800 dark:bg-tertiary dark:text-black animate-bounce"
    : "bg-yellow-100 text-yellow-800 dark:bg-yellow-500 dark:text-black";
---

<span class={`w-fit text-sm font-medium px-2.5 py-0.5 rounded-full ${classes}`}>
    {isAvailable ? t("hero.badge.available") : t("hero.badge.working")}
</span>
