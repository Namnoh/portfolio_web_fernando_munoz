---
import ExperienceItem from "./ExperienceItem.astro"
import { getCollection } from 'astro:content';

const lang = Astro.currentLocale || "es";
const EXPERIENCES = await getCollection("experience", (entry) => entry.id.startsWith(`${lang}/`));
---

<ol class="relative border-s border-gray-600 dark:border-white ml-3.5">                  
    {
        EXPERIENCES.map( (experience) => {
            const { data } = experience;
            return (
                <li class="mb-10 ms-4">
                    <ExperienceItem {...data} experience={experience} />
                </li>
            );
        })
    }
</ol>